{
  "name": "addons-poc",
  "private": true,
  "scripts": {
    "test": "pnpm -r --filter './packages/**' test",
    "dev": "node scripts/dev-all.mjs --open",
    "dev:host": "pnpm --filter @addons/host-app dev",
    "dev:addons": "pnpm -r --parallel --filter './packages/addon-text-*' serve",

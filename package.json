{
  "name": "addons-poc",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "test": "pnpm check:host-boundary && pnpm run build:protocol && pnpm -r --filter './packages/**' test",
    "check:host-boundary": "node scripts/check-host-boundary.mjs",
    "dev": "pnpm run build:protocol && node scripts/dev-all.mjs --open",
    "dev:host": "pnpm --filter @addons/host-app dev",
    "dev:addons": "pnpm run build:protocol && pnpm -r --parallel --filter './packages/addon-text-*' serve",
    "dev:hello": "pnpm run build:protocol && pnpm --filter @addons/addon-hello serve",
    "kill-all": "node scripts/kill-all.mjs",
    "build:protocol": "pnpm --filter @addons-poc/protocol run clean && pnpm --filter @addons-poc/protocol run build",
    "build:host": "pnpm run build:protocol && pnpm --filter @addons/host-app build"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}

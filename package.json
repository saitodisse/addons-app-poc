{
  "name": "peekmosaic",
  "version": "1.19.1",
  "private": true,
  "scripts": {
    "test": "pnpm check:host-boundary && pnpm run build:protocol && pnpm -r --filter './packages/**' test && node --test deployment/addons/release.test.mjs",
    "check:host-boundary": "node scripts/check-host-boundary.mjs",
    "dev": "pnpm run build:protocol && node scripts/dev-all.mjs --open",
    "dev:host": "pnpm --filter @addons/host-app dev",
    "dev:addons": "pnpm run build:protocol && pnpm -r --parallel --filter './packages/addon-text-*' --filter './packages/addon-chord-*' serve",
    "kill-all": "node scripts/kill-all.mjs",
    "build:protocol": "pnpm --filter @addons-poc/protocol run clean && pnpm --filter @addons-poc/protocol run build",
    "build:host": "pnpm run build:protocol && pnpm --filter @addons/host-app build",
    "addons:prepare": "node deployment/addons/prepare-release.mjs",
    "addons:verify": "node deployment/addons/verify-release.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "vercel": "^64.5.0"
  }
}

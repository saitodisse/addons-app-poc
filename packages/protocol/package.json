{
  "name": "@addons-poc/protocol",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Contrato público e SDK para add-ons confiáveis do addons-app-poc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saitodisse/addons-app-poc.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/addon-contract.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": ["addons", "plugins", "protocol"],
  "author": "AC Add-ons POC contributors",
  "bugs": {
    "url": "https://github.com/saitodisse/addons-app-poc/issues"
  },
  "homepage": "https://github.com/saitodisse/addons-app-poc#readme"
}
